    "faq_Xbabzm": {
      "type": "faq",
      "blocks": {
        "question_7LUMiR": {
          "type": "question",
          "settings": {
            "title": "Legierung",
            "text": "<p>Alternative Schreibweisen: Aluminiumlegierung<br/><br/>Erklärung:<br/>Eine Legierung ist eine Mischung aus zwei oder mehr Metallen zur Verbesserung spezifischer Materialeigenschaften. Aluminiumlegierungen enthalten oft Magnesium, Silicium oder Kupfer, um Festigkeit, Korrosionsbeständigkeit oder Bearbeitbarkeit zu optimieren.</p>"
          }
        },
        "question_taMR4m": {
          "type": "question",
          "settings": {
            "title": "Leitfähigkeit",
            "text": "<p>Alternative Schreibweisen: elektrische Leitfähigkeit, Wärmeleitfähigkeit<br/><br/>Erklärung:<br/>Aluminium hat eine hohe elektrische und thermische Leitfähigkeit. Es wird daher häufig als Alternative zu Kupfer in Stromleitungen oder als Material für Wärmetauscher und Kühlkörper verwendet. Dank des geringen Gewichts ist es besonders vorteilhaft für den Einsatz in der Elektrotechnik und in der Automobilindustrie.</p>"
          }
        },
        "question_wTU8Hn": {
          "type": "question",
          "settings": {
            "title": "Lochblech",
            "text": "<p>Alternative Schreibweisen: Perforiertes Blech, gelochtes Aluminiumblech<br/><br/>Erklärung:<br/>Ein perforiertes Aluminiumblech mit Löchern in verschiedenen Formen für Lüftung, Design oder Filtration.</p>"
          }
        }
      },
