    "glossar_xVrxp3": {
      "type": "glossar",
      "blocks": {
        "term_yWcnQb": {
          "type": "term",
          "settings": {
            "title": "Dichte",
            "text": "<p>Alternative Schreibweisen: Massendichte, spezifisches Gewicht<br/><br/>Erklärung:<br/>Die Dichte von Aluminium beträgt ca. 2,7 g/cm³ und ist damit deutlich geringer als die von Stahl. Dies macht Aluminium zu einem bevorzugten Werkstoff für Leichtbaukonstruktionen. Trotz des geringen Gewichts bietet Aluminium eine hohe Festigkeit und ist besonders gut verarbeitbar.</p>"
          }
        }
      },
      "block_order": [
