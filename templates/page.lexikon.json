    "faq_MrHtKt": {
      "type": "faq",
      "blocks": {
        "question_hxNWCK": {
          "type": "question",
          "settings": {
            "title": "Recycling",
            "text": "<p>Alternative Schreibweisen: Wiederverwertung, Sekundäraluminium<br/><br/>Erklärung:<br/>Aluminium ist zu 100 % recycelbar, ohne Qualitätsverluste. Der Recyclingprozess benötigt nur ca. 5 % der Energie, die für die Erstproduktion erforderlich ist. Dadurch wird Aluminium zu einem nachhaltigen Werkstoff, der weltweit in verschiedenen Industrien wiederverwertet wird.</p>"
          }
        },
        "question_UJpbxQ": {
          "type": "question",
          "settings": {
            "title": "Reinaluminium",
            "text": "<p>Alternative Schreibweisen: Al99,5, hochreines Aluminium<br/><br/>Erklärung:<br/>Reinaluminium enthält mindestens 99 % Aluminium und wird in chemischen und elektrischen Anwendungen eingesetzt.</p>"
          }
        },
        "question_yRRUkg": {
          "type": "question",
          "settings": {
            "title": "Riffelblech",
            "text": "<p>Alternative Schreibweisen: Warzenblech, Tränenblech<br/><br/>Erklärung:<br/>Ein Riffelblech ist eine strukturierte Aluminiumplatte mit rutschfester Oberfläche. Es wird für Bodenbeläge, Treppen und Fahrzeugböden verwendet.</p>"
          }
        },
        "question_trxVKh": {
          "type": "question",
          "settings": {
            "title": "Rohrverbinder",
            "text": "<p>Alternative Schreibweisen: Steckverbinder, Rohrkupplung<br/><br/>Erklärung:<br/>Rohrverbinder aus Aluminium ermöglichen die stabile Verbindung von Aluminiumrohren in Konstruktionen.</p>"
          }
        },
        "question_wNQ64q": {
          "type": "question",
          "settings": {
            "title": "Rohrverschlussstopfen",
            "text": "<p>Alternative Schreibweisen: Endkappe, Rohrkappe<br/><br/>Erklärung:<br/>Diese Stopfen dienen zum Verschließen von Aluminiumrohren und sorgen für ein sauberes Finish.</p>"
          }
        },
        "question_4VDLFQ": {
          "type": "question",
          "settings": {
            "title": "Rund",
            "text": "<p>Alternative Schreibweisen: Aluminiumstab, Rundmaterial<br/><br/>Erklärung:<br/>Runde Aluminiumteile wie Stangen oder Rohre werden in verschiedenen Industrien genutzt. Sie zeichnen sich durch hohe Korrosionsbeständigkeit und gute Formbarkeit aus.</p>"
          }
        },
        "question_CLy9K9": {
          "type": "question",
          "settings": {
            "title": "Rundrohr",
            "text": "<p>Alternative Schreibweisen: Aluminiumrundrohr, Hohlstab<br/><br/>Erklärung:<br/>Ein Rundrohr ist ein hohles Aluminiumprofil mit kreisförmigem Querschnitt. Es wird im Fahrzeugbau, in der Möbelindustrie und für Konstruktionen eingesetzt.</p>"
          }
        }
      },
