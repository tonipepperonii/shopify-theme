          "settings": {
            "code": "<a href=\"#A\"><h2 id=\"Nach Oben\"><center><strong>A</a> \n<a href=\"#B\">B</a> \n<a href=\"#C\">C</a> \n<a href=\"#D\">D</a> \n<a href=\"#E\">E</a> \n<a href=\"#F\">F</a> \n<a href=\"#H\">H</a> \n<a href=\"#K\">K</a> \n<a href=\"#L\">L</a> \n<a href=\"#M\">M</a> \n<a href=\"#N\">N</a> \n<a href=\"#O\">O</a> \n<a href=\"#P\">P</a> \n<a href=\"#R\">R</a> \n<a href=\"#S\">S</a> \n<a href=\"#T\">T</a> \n<a href=\"#U\">U</a> \n<a href=\"#V\">V</a> \n<a href=\"#W\">W</a> \n<a href=\"#Z\">Z</h2></strong></center></a>",
