    "faq_VgUFMn": {
      "type": "faq",
      "blocks": {
        "question_NbyNLY": {
          "type": "question",
          "settings": {
            "title": "Wärmeleitfähigkeit",
            "text": "<p>Alternative Schreibweisen: <br/><br/>Erklärung:<br/>Aluminium besitzt eine hohe Wärmeleitfähigkeit, was es ideal für Kühlkörper, Wärmetauscher und elektronische Bauteile macht.</p>"
          }
        },
        "question_L3kRG9": {
          "type": "question",
          "settings": {
            "title": "Winkelprofil",
            "text": "<p>Alternative Schreibweisen: L-Profil, Alu-Winkel<br/><br/>Erklärung:<br/>Ein Winkelprofil ist ein L-förmiges Aluminiumprofil, das für Konstruktionen und Verstärkungen genutzt wird. Es bietet hohe Stabilität und Korrosionsbeständigkeit bei geringem Gewicht.</p>"
          }
        }
      },
