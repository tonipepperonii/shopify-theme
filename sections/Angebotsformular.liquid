 <!-- Styling für Erfolgs-/Fehlermeldungen -->
<style>
  #form-message {
    margin: 1rem 0;
    padding: 1rem;
    text-align: center;
    font-weight: bold;
    border-radius: 6px;
  }
  .form-success {
    background-color: #dff0d8;
    color: #3c763d;
    border: 1px solid #3c763d;
  }
  .form-error {
    background-color: #f2dede;
    color: #a94442;
    border: 1px solid #a94442;
  }
</style>

<!-- JavaScript für Erfolgs-/Fehlermeldungen -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.querySelector(".contact-form");
    const messageBox = document.getElementById("form-message");

    form.addEventListener("submit", function (event) {
      event.preventDefault();

      // Simulierte Erfolgs- oder Fehlerprüfung
      const success = Math.random() > 0.2; // 80% Chance auf Erfolg
      messageBox.style.display = "block";

      if (success) {
        messageBox.textContent = "Deine Anfrage wurde erfolgreich gesendet!";
        messageBox.classList.add("form-success");
        messageBox.classList.remove("form-error");
        form.reset(); // Formular leeren
      } else {
        messageBox.textContent = "Es gab einen Fehler beim Absenden. Bitte versuche es erneut.";
        messageBox.classList.add("form-error");
        messageBox.classList.remove("form-success");
      }

      messageBox.scrollIntoView({ behavior: "smooth" });
    });
  });
  
</script>

