<div class="index-section newsletter-{{ section.id }} color-scheme-{{ section.settings.color_scheme }}">
  {%- if section.settings.color_scheme != 'none' -%}
    {%- render 'color-scheme-texture', color_scheme: section.settings.color_scheme -%}
  {%- endif -%}
  <div class="page-width{% if section.settings.narrow_column %} page-width--narrow{% endif %}">
    {%- if section.settings.title != blank or section.settings.text != blank -%}
      <div class="section-header text-center">
        {%- if section.settings.title != blank -%}
          <h2 class="section-header__title">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte section-header__rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {% endif %}
<style>
  .toleranz-buttons {
    display: flex;
    gap: 1rem;
  }

  .toleranz-button {
    background-color: #ff9933; /* orange wie Submit-Button */
    color: white;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    transition: background-color 0.2s ease;
    user-select: none;
  }

  .toleranz-button:hover {
    background-color: #e67e22;
  }

  .toleranz-button input {
    display: none;
  }

  .toleranz-button input:checked + span,
  .toleranz-button input:checked ~ label {
    background-color: #d35400;
  }

  .toleranz-button input:checked {
    outline: none;
  }

  .toleranz-button:has(input:checked) {
    background-color: #d35400;
  }
</style>


    <div class="form-vertical">
      {%- assign form_id = 'contact-' | append: section.id -%}
      {%- form 'contact', id: form_id -%}

        {%- if form.posted_successfully? -%}
          <p class="note note--success">
            {{ 'contact.form.post_success' | t }}
