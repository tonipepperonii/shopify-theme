<div class="grid grid--small">
  <!-- Name -->
  <div class="grid__item medium-up--one-half">
    <label for="ContactFormName-{{ section.id }}">Name<span style="color: red;">*</span></label>
    <input type="text" id="ContactFormName-{{ section.id }}" class="input-full" name="contact[name]" required autocapitalize="words" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
  </div>

  <!-- E-Mail -->
  <div class="grid__item medium-up--one-half">
    <label for="ContactFormEmail-{{ section.id }}">E-Mail<span style="color: red;">*</span></label>
    <input type="email" id="ContactFormEmail-{{ section.id }}" class="input-full" name="contact[email]" required autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
  </div>

  <!-- Eloxieren + Profil/Platte -->
  <div class="grid__item medium-up--one-half">
    <label for="eloxieren">Eloxieren<span style="color: red;">*</span></label>
    <select id="eloxieren" name="contact[Eloxieren]" class="input-full" required>
      <option value="">Bitte wählen</option>
      <option value="Nein">Nein</option>
      <option value="Silber">Silber EV1</option>
      <option value="Schwarz">Schwarz C35</option>
    </select>
  </div>

  <div class="grid__item medium-up--one-half">
    <label for="profil_platte">Profil / Platte<span style="color: red;">*</span></label>
    <input type="text" id="profil_platte" name="contact[Profil oder Platte]" class="input-full" required placeholder="z. B. U-Profil" />
  </div>

  <!-- Menge -->
<div class="grid__item medium-up--one-half">
  <label for="menge">Menge<span style="color: red;">*</span></label>
  <input type="number" id="menge" name="contact[Menge]" class="input-full" required placeholder="z. B. 50" min="0" />
</div>
  
  <!-- Maße -->
  <div class="grid__item medium-up--one-half">
    <label for="hoehe">Höhe (mm)<span style="color: red;">*</span></label>
    <input type="number" id="hoehe" name="contact[Höhe]" class="input-full" required placeholder="mm" min="0" />
  </div>

  <div class="grid__item medium-up--one-half">
    <label for="breite">Breite (mm)<span style="color: red;">*</span></label>
    <input type="number" id="breite" name="contact[Breite]" class="input-full" required placeholder="mm" min="0" />
  </div>
  
<!-- Stärke -->
<div class="grid__item medium-up--one-half">
  <label for="staerke">Stärke (mm)<span style="color: red;">*</span></label>
  <input type="number" id="staerke" name="contact[Stärke]" class="input-full" required placeholder="mm" min="0" />
</div>

  <div class="grid__item medium-up--one-half">
    <label for="laenge">Länge (mm)<span style="color: red;">*</span></label>
    <input type="number" id="laenge" name="contact[Länge]" class="input-full" required placeholder="mm" min="0" />
  </div>
  
<!-- Dynamischer Hinweis bei bestimmten Längen -->
<div id="schnitt-hinweis-wrapper" class="grid__item medium-up--one-whole" style="display: none; margin-top: 1.5rem;">
  <p style="margin-bottom: 0.8rem;">
    Du hast eine Länge von <strong>1000mm</strong>, <strong>1500mm</strong> oder <strong>2000mm</strong> gewählt.<br>
    Wenn wir komplette Lagerlängen aufsägen, werden diese ca. <strong>5 mm kürzer</strong> (durch die Sägeblattdicke).<br>
    Wärst du damit einverstanden?
  </p>

  <!-- Verstecktes Feld, das durch Button-Klick gesetzt wird -->
  <input type="hidden" id="toleranz-wert" name="contact[Schnitt-Toleranz akzeptiert]" required>

  <div class="toleranz-buttons">
    <button type="button" class="toleranz-button" data-value="Ja">Ja</button>
    <button type="button" class="toleranz-button" data-value="Nein">Nein</button>
  </div>
</div>

<!-- Checkbox Maße-Angabe -->
<div class="grid__item medium-up--one-whole">
  <label for="masse_bestaetigung" style="display: flex; align-items: center;">
    <input type="checkbox" id="masse_bestaetigung" name="contact[Maße bestätigt]" required style="margin-right: 0.5em;">
    Alle Maße wurden in mm angegeben und werden so verarbeitet.<span style="color: red;">*</span>
  </label>
</div>

<!-- Pflichtfeld-Hinweis -->
<div class="grid__item medium-up--one-whole">
  <p><span style="color: red;">*</span> Pflichtfeld</p>
</div>
</div> <!-- Ende .grid -->

