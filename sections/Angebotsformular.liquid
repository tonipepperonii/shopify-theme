<!-- 🔶 STYLE: Toleranz-Buttons -->
<style>
  .toleranz-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .toleranz-button {
    background-color: #ff9933;
    color: white;
    padding: 0.6rem 1.2rem;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    text-align: center;
    border: none;
    transition: background-color 0.2s ease;
  }

  .toleranz-button:hover {
    background-color: #e67e22;
  }

  .toleranz-button.active {
    background-color: #d35400;
  }
</style>

<!-- 🔧 SCRIPT: Button-Auswahl + Sichtbarkeit -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const laengeInput = document.getElementById("laenge");
    const hinweisWrapper = document.getElementById("schnitt-hinweis-wrapper");
    const toleranzButtons = document.querySelectorAll(".toleranz-button");
    const hiddenField = document.getElementById("toleranz-wert");

    const relevanteLaengen = ["1000", "1500", "2000"];

    function checkLaenge() {
      const value = laengeInput.value.trim();
      if (relevanteLaengen.includes(value)) {
        hinweisWrapper.style.display = "block";
      } else {
        hinweisWrapper.style.display = "none";
        hiddenField.value = "";
        toleranzButtons.forEach(btn => btn.classList.remove("active"));
      }
    }

    // Klick auf Ja/Nein-Button → Wert setzen + Stil
    toleranzButtons.forEach(btn => {
      btn.addEventListener("click", function () {
        hiddenField.value = this.dataset.value;
        toleranzButtons.forEach(b => b.classList.remove("active"));
        this.classList.add("active");
      });
    });

    laengeInput.addEventListener("input", checkLaenge);
    checkLaenge();
  });
</script>


