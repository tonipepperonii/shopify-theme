{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div class="page-width">
  {%- if section.settings.title != blank -%}
    <header class="section-header text-center vz-glossar-title">
      <h2 class="section-header__title">
        {{ section.settings.title | escape }}
      </h2>
    </header>
    <div class="vz-title-line"></div>
  {%- endif -%}
  
  {%- if section.settings.description != blank -%}
    <p class="vz-glossar-description">
      {{ section.settings.description | escape }}
    </p>
  {%- endif -%}
</div>

<div class="page-width page-width--medium">
  {%- if section.blocks.size > 0 -%}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Glossar",
        "mainEntity": [
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'term' %}
                {
                  "@type": "text",
                  "name": {{ block.settings.title | json }},
                  "acceptedAnswer": {
                    "@type": "richtext",
                    "text": {{ block.settings.text | json }}
                  }
                }{% unless forloop.last %},{% endunless %}
            {% endcase %}
          {% endfor %}
        ]
      }
    </script>

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {% case block.type %}
          {% when 'rich-text'%}
            <div class="index-section index-section--glossar">
              <div class="text-{{ block.settings.align_text }}">
                {%- if block.settings.title != blank -%}
                  <p class="h2">
                    {{ block.settings.title | escape }}
                  </p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte">
                    {%- if block.settings.enlarge_text %}<div class="enlarge-text">{% endif -%}
                      {{ block.settings.text }}
                    {%- if block.settings.enlarge_text %}</div>{% endif -%}
                  </div>
                {%- endif -%}
              </div>
            </div>

          {% when 'term'%}
            <div class="collapsible-trigger-btn--borders">
              <button type="button"
                class="label collapsible-trigger collapsible-trigger-btn collapsible--auto-height"
                aria-controls="Glossar-content-{{ block.id }}">
                <span class="collapsible-trigger__layout">
                  <span>
                    <span>{%- render 'collapsible-icons-plus' -%}{{ block.settings.title }}</span>
                  </span>
                </span>
              </button>
              <div id="Glossar-content-{{ block.id }}" class="collapsible-content collapsible-content--all">
                <div class="collapsible-content__inner rte">
                  {{ block.settings.text }}
                </div>
              </div>
            </div>
        {% endcase %}
      </div>
    {%- endfor -%}
  {%- endif -%}

  {%- if section.blocks.size == 0 -%}
    <div class="placeholder-noblocks">
      {{ 'home_page.onboarding.no_content' | t }}
    </div>
  {%- endif -%}
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

{% schema %}
{
  "name": "Glossar",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Glossar"
    },
    { 
      "type": "text",
      "id": "description",
      "label": "Beschreibung",
      "default": "Hier finden Sie wichtige Begriffe rund um Aluminium – einfach erklärt."
    }
  ],
  "blocks": [
    {
      "type": "rich-text",
      "name": "Einleitungstext",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Überschrift",
          "default": "Einleitung"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Begriffe rund ums Thema Aluminium kurz & verständlich erklärt.</p>"
        },
        {
          "type": "select",
          "id": "align_text",
          "label": "Textausrichtung",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Links"
            },
            {
              "value": "center",
              "label": "Zentriert"
            },
            {
              "value": "right",
              "label": "Rechts"
            }
          ]
        }
      ]
    },
    {
      "type": "term",
      "name": "Glossar-Begriff",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Begriff",
          "default": "Eloxieren"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Erklärung",
          "default": "<p>Oberflächenveredelung durch elektrochemisches Verfahren.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glossar mit Begriffen",
      "blocks": [
        {
          "type": "term"
        },
        {
          "type": "term"
        }
      ]
    }
  ]
}
{% endschema %}
